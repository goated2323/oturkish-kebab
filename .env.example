PORT=8080
STATIC_DIR=.
# Stripe - créez un compte sur https://dashboard.stripe.com/test/apikeys
# clé secrète test commence par sk_test_
STRIPE_SECRET_KEY=sk_test_... 
# optionnel: clé publique pour le front (pk_test_)
STRIPE_PUBLISHABLE_KEY=pk_test_...
# URLs de retour Stripe (par défaut: origin + ?success / ?canceled)
STRIPE_SUCCESS_URL=http://127.0.0.1:8080/?success=1
STRIPE_CANCEL_URL=http://127.0.0.1:8080/?canceled=1
# Pour désactiver les logs trace
RUST_LOG=info
# Appel vocal cuisine à chaque commande (CallMeBot, gratuit) :
# 1) Installe Telegram, discute avec @CallMeBot_API, autorise le bot
# 2) Mets ton pseudo Telegram ci-dessous (ex. @cuisine_oturkish)
CALLMEBOT_TG_USER=@...
CALLMEBOT_LANG=fr-FR-Standard-A
CALLMEBOT_RPT=2
